{
  "manifest_version": 3,
  "name": "C.S.R. Sponsor Extensie",
  "description": "Word eraan herinnerd om relevante websites via gesponsorde C.S.R. links te bezoeken",
  "author": "pubcie@csrdelft.nl",
  "homepage_url": "https://csrdelft.nl/",
  "version": "4.0",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "webNavigation",
    "alarms",
    "notifications",
    "storage"
  ],
  "content_scripts": [
    {
      "js": [
        "src/installed.js"
      ],
      "matches": [
        "*://*.csrdelft.nl/*"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "./src/background.js",
    "scripts": [
      "./src/background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": false
  },
  "action": {},
  "browser_specific_settings": {
    "gecko": {
      "id": "pubcie@csrdelft.nl"
    }
  },
  "host_permissions": [
    "https://api.sponsorkliks.com/v1.0/*"
  ]
}
