{
    "name": "C.S.R. Sponsor Extensie",
    "version": "3.3",
    "manifest_version": 3,
    "description": "Word eraan herinnerd om relevante websites via gesponsorde C.S.R. links te bezoeken",
    "homepage_url": "https://csrdelft.nl/",
    "icons": {
        "16": "icons/icon128.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background-wrapper.js"
    },
    "_content_scripts": [
        {
            "matches": ["*://*.csrdelft.nl/*"],
            "js": ["src/installed.js"],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "src/settings/settings.html",
        "browser_style": true,
        "_chrome_style": true
    },
    "action": {},
    "_page_action": {
        "default_icon": "icons/icon48.png"
    },
    "permissions": [
        "webNavigation",
        "alarms",
        "notifications",
        "activeTab",
        "storage"
    ],
    "host_permissions": ["*://*.csrdelft.nl/API/*"],
    "applications": {
        "gecko": {
            "id": "pubcie@csrdelft.nl"
        }
    }
}
